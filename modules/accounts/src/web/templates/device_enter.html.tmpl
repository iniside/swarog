{%- extends "device_base.html" -%}
{%- block card %}
<div>
<h1>Connect a device</h1>
<div class="muted" style="font-size: 13px">Enter the code shown on your device.</div>
</div>
{%- if error %}
<div class="banner err">{{ error }}</div>
{%- endif %}
<form method="get" action="/accounts/oidc/device" class="stack" style="gap: 18px">
<div class="code-in" role="group" aria-label="Device code">
{%- for i in range(1, 9) %}
{%- if i == 5 %}
<span class="dim mono">-</span>
{%- endif %}
<input class="input" name="c{{ i }}" aria-label="Character {{ i }}" autocomplete="off"{% if i == 1 %} autofocus{% endif %}>
{%- endfor %}
</div>
<div class="row"><span class="grow dim" style="font-size: 12px">A code expires at most {{ ttl }} after it is issued.</span><button class="btn primary" type="submit">Continue</button></div>
</form>
{%- endblock %}
