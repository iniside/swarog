{#- The sign-in page, styled like core/admin's login from the same design-system classes. -#}
{%- extends "base.html" -%}
{%- block title %}Sign in{% endblock -%}
{%- block content %}
<section class="panel">
<div class="panel-head"><span class="panel-title">Sign in</span></div>
{%- if error %}<div class="banner err">{{ error }}</div>{% endif %}
<div class="panel-body">
<form method="post" action="/accounts/oidc/login" class="stack">
<input type="hidden" name="csrf" value="{{ csrf }}">
<input type="hidden" name="return_to" value="{{ return_to }}">
<label class="stack" style="gap:4px"><span class="dim" style="font-weight:500">Email</span><input class="input" type="email" name="email" autofocus autocomplete="username" required></label>
<label class="stack" style="gap:4px"><span class="dim" style="font-weight:500">Password</span><input class="input" type="password" name="password" autocomplete="current-password" required></label>
<button type="submit" class="btn primary" style="justify-content:center">Sign in</button>
</form>
</div>
</section>
{%- endblock %}
