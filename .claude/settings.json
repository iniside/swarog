{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "300"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ref_reminder.py\"",
            "statusMessage": "Checking reference docs"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_safety_hook.py\"",
            "statusMessage": "Git safety + commit-trailer guard"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/grep_sweep_guard.py\"",
            "statusMessage": "Blocking shell sweeps that bypass .gitignore"
          }
        ]
      },
      {
        "matcher": "Agent|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_worktree_hook.py\"",
            "statusMessage": "Blocking git worktrees"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/explicit_model_guard.py\"",
            "statusMessage": "Enforcing explicit subagent model"
          }
        ]
      },
      {
        "matcher": "Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scout_nav_guard.py\" gate",
            "statusMessage": "Navigation: LSP before a wide Rust search, no repeated file slices"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scout_nav_guard.py\" report",
            "statusMessage": "code-scout: checking anchor labels against LSP calls"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_budget_guard.py\" send",
            "statusMessage": "Context budget: fresh agent instead of resuming a large one"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_budget_guard.py\" work",
            "statusMessage": "Context budget: part hand-off past the subagent limit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_commit_review_reminder.py\"",
            "statusMessage": "Reminding to dispatch core-reviewer after commit"
          }
        ]
      },
      {
        "matcher": "LSP|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scout_nav_guard.py\" record",
            "statusMessage": "Recording navigation (LSP calls, code-scout dispatches)"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "LSP",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/scout_nav_guard.py\" record",
            "statusMessage": "code-scout: recording a failed navigation call"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact_gate.py\"",
            "statusMessage": "Compaction waits for running subagents"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 150000
}
