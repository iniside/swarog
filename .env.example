# Copy to .env. URL-safe characters only: the value is embedded in DATABASE_URL.
SWAROG_DB_PASSWORD=

# Listen address and host HTTP port (default 127.0.0.1:8080).
# SWAROG_BIND=127.0.0.1
# SWAROG_HTTP_PORT=8080

# Native TLS: files mode reads the cert and key from ./tls (mounted at /tls).
# TLS_MODE=files
# TLS_CERT_PATH=/tls/cert.pem
# TLS_KEY_PATH=/tls/key.pem
# ACME mode needs SWAROG_BIND=0.0.0.0, SWAROG_HTTP_PORT=443 and public DNS.
# TLS_MODE=acme
# ACME_DOMAINS=game.example.com
# ACME_CONTACT=mailto:ops@example.com

# Set this when running behind a reverse proxy.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Mail: unset boots the server with /readyz red until a provider is configured.
# Never write a KEY= line with an empty value; the server rejects it.
# MAIL_PROVIDER=smtp
# MAIL_FROM=noreply@example.com
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=smtp-user
# MAIL_SMTP_PASSWORD=smtp-password
# MAIL_SMTP_TLS=starttls
