{#- Action modals (ConfirmAction, Form), the POST results and the show-once
    SecretReveal, lifted from bundle.js `modal`/`confirm`/`secret` and pages-platform.js. -#}
{%- import "primitives.html" as ui -%}

{%- macro modal(m) -%}
{%- set gated = m.type_to_confirm or (m.reason == "required" and not m.reason_value) -%}
<div class="scrim" data-scrim>
<form class="modal" role="dialog" aria-modal="true" hx-post="{{ m.post_url }}" hx-target="#modal-root" hx-swap="innerHTML" data-gate>
{%- if m.csrf %}<input type="hidden" name="_csrf" value="{{ m.csrf }}">{% endif -%}
<input type="hidden" name="_form" value="{{ m.form_id }}">
<div class="modal-head"><div class="modal-icon {{ m.tone }}">{{ ui.icon(m.icon) }}</div><div><h2>{{ m.title }}</h2>{% if m.form and m.form.note %}<div class="muted" style="font-size:12px">{{ m.form.note }}</div>{% endif %}</div></div>
{%- if m.banner %}<div class="banner err">{{ ui.icon("alert") }} {{ m.banner }}</div>{% endif -%}
<div class="modal-body">
{%- if m.form %}{{ ui.form_fields(m.form) }}
{%- else -%}
{{ m.body }}
{%- if m.impact %}<div class="impact">{% for k, v in m.impact %}<div><span>{{ k }}</span><b>{{ v }}</b></div>{% endfor %}</div>{% endif -%}
{%- if m.reason != "none" %}<div style="margin-top:10px"><div style="font-size:12px;margin-bottom:4px">Reason <span class="muted">(recorded in audit log)</span></div><input class="input" style="width:100%{% if m.reason_error %};border-color:var(--err){% endif %}" name="_reason" value="{{ m.reason_value }}" autocomplete="off"{% if m.reason == "required" %} data-reason-required{% endif %}>{% if m.reason_error %}<div style="font-size:11.5px;color:var(--err);margin-top:4px">{{ m.reason_error }}</div>{% endif %}</div>{% endif -%}
{%- if m.type_to_confirm %}<div style="margin-top:10px"><div style="font-size:12px;margin-bottom:4px">Type <b class="mono">{{ m.type_to_confirm }}</b> to confirm</div><input class="input mono" style="width:100%" name="_confirm" data-confirm-type="{{ m.type_to_confirm }}" autocomplete="off"></div>{% endif -%}
{%- endif -%}
</div>
<div class="modal-foot"><span class="muted" style="margin-right:auto;font-size:12px;align-self:center"></span><button type="button" class="btn" data-modal-close>Cancel</button><button type="submit" class="btn {{ m.go }} go"{% if gated or m.locked %} disabled{% endif %}>{{ m.form.submit_label if m.form else m.confirm_label }}</button></div>
</form>
</div>
{%- endmacro %}

{#- A non-redirect POST result: the modal again with its errors, or a toast. -#}
{%- macro result(r) -%}
{%- if r.modal %}{{ modal(r.modal) }}{% else %}{{ ui.toast(r.toast, r.tone) }}{% endif -%}
{%- endmacro %}

{%- macro reveal(f) -%}
{%- set r = f.reveal -%}
<div class="scrim" data-scrim data-reveal>
<div class="modal" role="dialog" aria-modal="true">
<div class="modal-head"><div class="modal-icon ok">{{ ui.icon("check") }}</div><div><h2>{{ f.message or r.label }}</h2>{% if f.message %}<div class="muted" style="font-size:12px">{{ r.label }}</div>{% endif %}</div></div>
<div class="modal-body"><div class="secret"><div class="row" style="color:var(--warn);font-weight:600">{{ ui.icon("key") }} Copy this secret now</div><div style="font-size:12px;color:var(--text-2);margin-top:4px">{{ r.hint or "It is shown exactly once." }}</div><div class="secret-value"><span data-secret>{{ r.value }}</span><button type="button" class="btn sm" data-copy><span data-copy-idle class="row" style="gap:6px">{{ ui.icon("copy") }} Copy</span><span data-copy-done class="row" style="gap:6px" hidden>{{ ui.icon("check") }} Copied</span></button></div>{% if r.expires_at %}<div style="margin-top:10px;font-size:12px" class="dim">Expires {{ r.expires_at }}.</div>{% endif %}</div><label class="row" style="margin-top:12px;font-size:12.5px"><input type="checkbox" data-ack> I stored the secret somewhere safe</label></div>
<div class="modal-foot"><button type="button" class="btn primary" data-ack-done data-modal-close disabled>Done</button></div>
</div>
</div>
{%- endmacro %}
