<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameBackend.Client</RootNamespace>
    <AssemblyName>gbclient</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1416: System.Net.Quic is annotated linux/macOS/windows-only. Every call site
         is behind a runtime QuicConnection.IsSupported guard, so the
         platform-compat analyzer warning is noise here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
